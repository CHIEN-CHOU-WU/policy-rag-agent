# LLM provider: "ollama" (default), "groq", "gemini" or "anthropic"
LLM_PROVIDER=ollama

# Option A — local model via Ollama (free, runs offline)
OLLAMA_MODEL=qwen3:8b
# OLLAMA_HOST=http://localhost:11434

# Option B — Claude (best quality; needs an API key)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Option C — Google Gemini (free tier). Also used as the judge in eval/run_eval.py.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_RPM=5            # requests per minute; 5 on the free tier

# Option D — Groq (free tier: 1,000 requests/day, 8,000 tokens/minute per model)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   # or qwen/qwen3.8-27b
